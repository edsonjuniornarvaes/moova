# Clerk – Dashboard > API Keys > Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase – Project Settings > General > Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase – Project Settings > API > anon (public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe – Dashboard > Developers > API Keys > Publishable key (pk_test_... ou pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry – Project Settings > General > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Sentry – 1 em __DEV__ para testar eventos; vazio ou 0 em produção para poupar quota
EXPO_PUBLIC_SENTRY_DEBUG=

# Sentry – Organization slug (source maps / EAS; opcional em dev só com app)
SENTRY_ORG=

# Sentry – Project slug
SENTRY_PROJECT=

# Sentry – Auth Token (não commitar; EAS Secrets ou máquina local)
SENTRY_AUTH_TOKEN=
